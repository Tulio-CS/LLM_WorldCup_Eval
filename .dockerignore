# Keep the image small and free of local state — DB + artifacts live on the volume.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
*.pyo
.ipynb_checkpoints

# Secrets (provided as env vars in Coolify, never baked into the image)
.env
.env.*

# Local generated state — recreated on the persistent volume at runtime
data/
*.db
*.db-journal
*.xlsx
experiment_manifest.json
config.test.json
results*.csv
scratch*
